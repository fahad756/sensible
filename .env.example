# Required for Gemini-backed responses. Do not expose this in browser code.
GEMINI_API_KEY=replace_with_your_gemini_api_key

# The user-requested Gemini 1.5 model is supported as a configurable default.
# If your account/API version no longer serves 1.5, the server will use the fallback.
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_FALLBACK_MODEL=gemini-2.5-flash

# Server config
PORT=8787
CORS_ORIGIN=*

# Optional public URL for deployments behind a proxy/load balancer.
PUBLIC_APP_URL=
